{
	"name": "kal-chat",
	"version": "0.0.1",
	"private": true,
	"author": {
		"name": "Kaleab S. Melkie",
		"email": "hi@kaleabmelkie.com",
		"url": "https://kaleabmelkie.com"
	},
	"engines": {
		"node": "^22",
		"pnpm": "^10"
	},
	"scripts": {
		"preinstall": "npx only-allow pnpm",
		"prepare": "husky",
		"sync": "svelte-kit sync",
		"dev": "svelte-kit sync && vite dev --host --port 5173",
		"build": "svelte-kit sync && vite build",
		"preview": "vite preview --port 5173",
		"check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
		"check:watch": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json --watch",
		"lint": "prettier --check . && eslint .",
		"format": "prettier --check --write . && eslint --fix .",
		"db:check": "drizzle-kit check:sqlite",
		"db:push": "drizzle-kit push:sqlite",
		"db:studio": "drizzle-kit studio"
	},
	"devDependencies": {
		"@auth/sveltekit": "1.9.2",
		"@builder.io/partytown": "0.10.3",
		"@libsql/client": "0.15.8",
		"@sentry/node": "7.120.3",
		"@sentry/svelte": "7.120.3",
		"@sentry/tracing": "7.120.3",
		"@sveltejs/adapter-vercel": "5.7.2",
		"@sveltejs/kit": "2.21.1",
		"@sveltejs/vite-plugin-svelte": "3.1.2",
		"@tailwindcss/forms": "0.5.10",
		"@tailwindcss/typography": "0.5.16",
		"@types/eslint": "8.56.12",
		"@types/node": "^22",
		"@types/nprogress": "0.2.3",
		"@types/sanitize-html": "2.16.0",
		"@typescript-eslint/eslint-plugin": "7.18.0",
		"@typescript-eslint/parser": "7.18.0",
		"autoprefixer": "10.4.21",
		"bowser": "2.11.0",
		"dayjs": "1.11.13",
		"dotenv": "16.5.0",
		"drizzle-kit": "0.31.1",
		"drizzle-orm": "0.44.0",
		"drizzle-zod": "0.8.2",
		"eslint": "8.57.1",
		"eslint-config-prettier": "9.1.0",
		"eslint-plugin-svelte": "2.46.1",
		"gpt3-tokenizer": "1.1.5",
		"groq-sdk": "0.23.0",
		"highlight.js": "11.11.1",
		"husky": "9.1.7",
		"marked": "13.0.3",
		"marked-highlight": "2.1.4",
		"marked-mangle": "1.1.10",
		"marked-smartypants": "1.1.9",
		"nprogress": "0.2.0",
		"openai-edge": "1.2.3",
		"postcss": "8.5.4",
		"prettier": "3.5.3",
		"prettier-plugin-svelte": "3.4.0",
		"prettier-plugin-tailwindcss": "0.6.11",
		"rollup-plugin-visualizer": "5.14.0",
		"sanitize-html": "2.17.0",
		"svelte": "4.2.20",
		"svelte-check": "3.8.6",
		"tailwindcss": "3.4.17",
		"tslib": "2.8.1",
		"typescript": "5.8.3",
		"vite": "5.4.19",
		"zod": "3.25.42"
	},
	"pnpm": {
		"onlyBuiltDependencies": [
			"@sveltejs/kit",
			"esbuild",
			"svelte-preprocess"
		]
	},
	"type": "module"
}
